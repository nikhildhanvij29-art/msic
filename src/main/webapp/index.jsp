<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#090d1c"><title>Shadow Strike - 5 Level Action Game</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#090d1c;color:white;font-family:Arial;touch-action:none}#game{height:100dvh;position:relative;background:#111}canvas{width:100%;height:100%;display:block}.hud{position:absolute;top:10px;left:10px;right:10px;display:flex;justify-content:space-between;z-index:2;pointer-events:none}.box{background:#071426dd;border:1px solid #75d5ff77;border-radius:10px;padding:8px 12px;font-weight:bold;text-shadow:0 2px 4px #000}.box small{display:block;color:#b9d9f4;font-size:10px}.box b{color:#ffd34e}.controls{position:absolute;bottom:calc(14px + env(safe-area-inset-bottom));left:0;right:0;padding:0 14px;display:flex;justify-content:space-between;z-index:3}.group{display:flex;gap:9px}.ctrl{width:clamp(55px,15vw,78px);height:clamp(55px,15vw,78px);border-radius:50%;border:1px solid #ffffffaa;background:#07182cbb;color:white;font-size:26px;font-weight:bold;touch-action:none}.ctrl span{display:block;font-size:9px}.ctrl:active,.ctrl.active{background:#087fc5}.overlay{position:absolute;inset:0;z-index:5;display:flex;align-items:center;justify-content:center;padding:18px;background:#020817bb}.card{width:min(430px,94vw);padding:25px 20px;text-align:center;border:1px solid #7bd7ff99;border-radius:18px;background:linear-gradient(145deg,#1b3152,#080f20);box-shadow:0 12px 45px #000b}.card h1{font-size:clamp(28px,8vw,42px);color:#ffd04a;margin:0 0 8px;font-style:italic}.card p{line-height:1.5;color:#d7e9f8}.card button{border:0;border-radius:9px;padding:13px 23px;background:linear-gradient(90deg,#087ee0,#13a9c7);color:white;font-size:16px;font-weight:bold}.muted{font-size:12px;color:#a8c4dc!important}.hidden{display:none!important}
</style></head>
<body><div id="game"><canvas id="c"></canvas>
<div class="hud"><div class="box"><small>HEALTH</small><b id="hp">100%</b></div><div class="box"><small>SHADOW STRIKE</small><b id="lv">LEVEL 1 / 5</b></div><div class="box"><small>SCORE</small><b id="sc">0</b></div></div>
<div class="controls"><div class="group"><button class="ctrl" data-k="left">◀<span>LEFT</span></button><button class="ctrl" data-k="right">▶<span>RIGHT</span></button></div><div class="group"><button class="ctrl" data-k="jump">⬆<span>JUMP</span></button><button class="ctrl" data-k="attack">✦<span>ATTACK</span></button></div></div>
<div class="overlay" id="start"><div class="card"><h1>SHADOW STRIKE</h1><p>Fight through five realms. Defeat enemy waves, survive the boss and become the champion.</p><p class="muted">Move: ◀ ▶ or A/D · Jump: ▲ or W · Attack: ✦ or Space</p><button id="go">START GAME</button></div></div>
<div class="overlay hidden" id="msg"><div class="card"><h1 id="mt">LEVEL COMPLETE</h1><p id="mp">Realm conquered!</p><button id="next">NEXT LEVEL</button></div></div>
</div>
<script>
(()=>{
const c=document.getElementById('c'),x=c.getContext('2d'),$=id=>document.getElementById(id);
let W,H,dpr,ground,level=1,score=0,hp=100,active=false,last=0,clock=0,kills=0,world=0,attack=0;
let hero={x:100,y:0,vy:0,w:34,h:58,face:1,ground:true,shield:0},enemies=[],sparks=[];
const input={left:false,right:false,jump:false,attack:false};
const worlds=[['#101b3a','#df6848','#34364b','#c04b45'],['#061f2c','#2b8060','#1e4538','#9bc75a'],['#260d19','#e34a20','#3b2028','#ff6338'],['#142f50','#9adcf0','#527b91','#75dff0'],['#100c29','#733e9a','#2a2340','#d25bff']];
function size(){dpr=Math.min(devicePixelRatio||1,2);W=c.clientWidth;H=c.clientHeight;c.width=W*dpr;c.height=H*dpr;x.setTransform(dpr,0,0,dpr,0,0);ground=H*.79;if(!hero.y)hero.y=ground-hero.h}addEventListener('resize',size);size();
function rect(a,b,w,h,col){x.fillStyle=col;x.fillRect(a,b,w,h)}
function burst(a,b,col){for(let i=0;i<10;i++)sparks.push({x:a,y:b,vx:(Math.random()-.5)*250,vy:-Math.random()*220,life:.5,col})}
function background(){let t=worlds[level-1],g=x.createLinearGradient(0,0,0,H);g.addColorStop(0,t[0]);g.addColorStop(1,t[1]);rect(0,0,W,H,g);for(let i=0;i<10;i++){let a=(i*W*.15-world*.25)%(W+100);if(a<0)a+=W+100;x.fillStyle='#080d2388';x.beginPath();x.moveTo(a,ground);x.lineTo(a+55,ground-70-(i%4)*25);x.lineTo(a+130,ground);x.fill()}rect(0,ground,W,H-ground,t[2]);rect(0,ground,W,4,'#ffffff55');for(let i=0;i<15;i++){let a=(i*105-world*.7)%(W+30);if(a<0)a+=W;rect(a,ground+25+(i%3)*14,35,4,'#0003')}}
function heroDraw(){let a=hero.x,b=hero.y;x.save();x.translate(a+hero.w/2,b+hero.h/2);x.scale(hero.face,1);x.fillStyle='#0007';x.beginPath();x.ellipse(0,hero.h/2+2,24,5,0,0,7);x.fill();x.fillStyle='#852747';x.beginPath();x.moveTo(-9,-12);x.lineTo(-23,23);x.lineTo(-3,14);x.fill();rect(-12,8,10,22,'#202b49');rect(3,8,10,22,'#202b49');rect(-14,-18,28,31,'#d34b3b');rect(-12,-16,24,16,'#e9a84c');x.fillStyle='#d89b72';x.beginPath();x.arc(0,-27,12,0,7);x.fill();rect(-13,-39,26,8,'#24213c');rect(2,-29,9,3,'#7cecff');x.strokeStyle='#e4f5ff';x.lineWidth=5;x.beginPath();x.moveTo(12,-8);x.lineTo(39,-34);x.stroke();if(hero.shield>0){x.strokeStyle='#7cecff';x.lineWidth=3;x.beginPath();x.arc(0,0,31,0,7);x.stroke()}x.restore()}
function enemyDraw(e){x.fillStyle=e.boss?'#a32bc1':worlds[level-1][3];x.fillRect(e.x,e.y,e.w,e.h);rect(e.x+7,e.y+10,e.w-14,12,'#27223b');rect(e.x+10,e.y+13,5,4,'#fff');rect(e.x+e.w-15,e.y+13,5,4,'#fff');if(e.boss){x.fillStyle='#fff';x.font='bold 10px Arial';x.fillText('BOSS',e.x+8,e.y-5)}}
function hud(){$('hp').textContent=Math.max(0,Math.ceil(hp))+'%';$('lv').textContent='LEVEL '+level+' / 5';$('sc').textContent=score}
function spawn(){let boss=level===5&&kills>=4;enemies.push({x:W+30,y:ground-(boss?68:52),w:boss?62:38,h:boss?68:52,hp:boss?5:1,boss,flash:0,speed:75+level*13+Math.random()*35})}
function reset(){score=0;level=1;hp=100;nextLevel();$('start').classList.add('hidden')}
function nextLevel(){hero.x=100;hero.y=ground-hero.h;hero.vy=0;hero.ground=true;enemies=[];sparks=[];kills=0;clock=.7;active=true;Object.keys(input).forEach(k=>input[k]=false);$('msg').classList.add('hidden');hud()}
function finish(title,text,button){active=false;$('mt').textContent=title;$('mp').textContent=text;$('next').textContent=button;$('msg').classList.remove('hidden')}
$('go').onclick=reset;$('next').onclick=()=>{if(level===5){$('msg').classList.add('hidden');$('start').classList.remove('hidden')}else{level++;nextLevel()}};
function update(dt){if(!active)return;world+=dt*80;hero.shield=Math.max(0,hero.shield-dt);attack=Math.max(0,attack-dt);let dir=(input.right?1:0)-(input.left?1:0);hero.x=Math.max(8,Math.min(W-hero.w-8,hero.x+dir*250*dt));if(dir)hero.face=dir;if(input.jump&&hero.ground){hero.vy=-540;hero.ground=false;input.jump=false}hero.vy+=1350*dt;hero.y+=hero.vy*dt;if(hero.y+hero.h>=ground){hero.y=ground-hero.h;hero.vy=0;hero.ground=true}
if(input.attack&&attack<=0){attack=.32;input.attack=false;burst(hero.x+hero.w/2+hero.face*30,hero.y+25,worlds[level-1][1]);enemies.forEach(e=>{let dx=e.x+e.w/2-(hero.x+hero.w/2);if(Math.abs(dx)<(hero.face>0?105:65)&&Math.abs(e.y-hero.y)<80){e.hp--;e.flash=.1;if(e.hp<=0){kills++;score+=e.boss?500:100;burst(e.x+e.w/2,e.y,worlds[level-1][1])}}})}
clock-=dt;if(clock<=0&&kills<(level===5?5:7)){spawn();clock=Math.max(.65,1.6-level*.1)}
enemies.forEach(e=>{e.x-=e.speed*dt;if(e.flash>0)e.flash-=dt;if(hero.shield<=0&&Math.abs(e.x+e.w/2-hero.x-hero.w/2)<(e.w+hero.w)*.45&&Math.abs(e.y-hero.y)<55){hp-=e.boss?22:12;hero.shield=.9;burst(hero.x,hero.y,'#ff4564');if(hp<=0){hp=0;hud();finish('DEFEATED','Your score: '+score,'RETURN TO MENU')}}});enemies=enemies.filter(e=>e.hp>0&&e.x>-100);sparks.forEach(p=>{p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=400*dt;p.life-=dt});sparks=sparks.filter(p=>p.life>0);if(kills>=(level===5?5:7)&&enemies.length===0){if(level===5)finish('VICTORY!','You conquered all five realms. Final score: '+score,'PLAY AGAIN');else finish('LEVEL '+level+' COMPLETE',worlds[level-1][0]+' realm conquered. Prepare for the next battle.','NEXT LEVEL')}hud()}
function draw(){background();enemies.forEach(enemyDraw);heroDraw();sparks.forEach(p=>{x.globalAlpha=Math.max(0,p.life*2);rect(p.x,p.y,4,4,p.col);x.globalAlpha=1});if(attack>0){x.strokeStyle=worlds[level-1][1];x.lineWidth=5;x.beginPath();x.arc(hero.x+hero.w/2+hero.face*25,hero.y+25,34,-1.2,1.2);x.stroke()}}
function loop(ts){let dt=Math.min((ts-last)/1000||0,.035);last=ts;update(dt);draw();requestAnimationFrame(loop)}requestAnimationFrame(loop);
document.querySelectorAll('[data-k]').forEach(b=>{let k=b.dataset.k,down=e=>{e.preventDefault();input[k]=true;b.classList.add('active')},up=e=>{e.preventDefault();input[k]=false;b.classList.remove('active')};b.addEventListener('pointerdown',down);['pointerup','pointercancel','pointerleave'].forEach(v=>b.addEventListener(v,up))});
let map={ArrowLeft:'left',ArrowRight:'right',a:'left',d:'right',ArrowUp:'jump',w:'jump',' ':'attack'};addEventListener('keydown',e=>{if(map[e.key]){e.preventDefault();input[map[e.key]]=true}});addEventListener('keyup',e=>{if(map[e.key])input[map[e.key]]=false});addEventListener('blur',()=>Object.keys(input).forEach(k=>input[k]=false));
})();
</script></body></html>

